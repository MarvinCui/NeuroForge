        {
          "key": "jobs.autofix.steps",
          "value": [
            {
              "name": "Checkout PR branch",
              "uses": "actions/checkout@v4",
              "with": {
                "fetch-depth": 0,
                "submodules": "recursive",
                "ref": "${{ github.event.pull_request.head.ref }}"
              }
            },
            {
              "name": "Install Octave",
              "run": "sudo apt-get update\nsudo apt-get install -y octave\n"
            },
            {
              "name": "Apply Autofix",
              "uses": "anthropics/claude-code-action@v1",
              "with": {
                "claude_code_oauth_token": "${{ secrets.CLAUDE_CODE_OAUTH_TOKEN || secrets.CLAUDE_MAX_OAUTH_TOKEN }}",
                "allowed_bots": "claude[bot]",
                "prompt": "PR: #${{ github.event.pull_request.number }}\nREVIEW: ${{ github.event.review.body }}\n\nA maintainer requested autofix. Read AGENTS.md.\n1. Fetch the full review with inline comments.\n2. Apply all actionable review comments to the PR branch.\n3. Keep changes small and consistent with EEGLAB MATLAB conventions.\n4. Run relevant MATLAB or Octave validation.\n5. Commit and push changes to the PR branch.\n6. Post a comment summarizing what changed and what validation ran, prefixed with \"Autofix:\".\n",
                "claude_args": "--model claude-opus-4-7\n--max-turns 150\n--allowedTools \"Bash(git:*),Bash(gh:*),Bash(matlab:*),Bash(octave:*),Bash(find:*),Bash(rg:*),Bash(sed:*),Bash(ls:*),Bash(pwd:*),Bash(cat:*)\"\n"
