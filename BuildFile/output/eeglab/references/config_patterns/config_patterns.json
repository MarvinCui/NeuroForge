        {
          "key": "jobs.matlab-smoke.env.MLM_LICENSE_TOKEN",
          "value": "${{ secrets.MATLAB_BATCH_TOKEN }}",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.matlab-smoke.steps",
          "value": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@v4",
              "with": {
                "submodules": "recursive"
              }
            },
            {
              "name": "Determine MATLAB availability",
              "id": "matlab",
              "shell": "bash",
              "run": "if [ -n \"$MLM_LICENSE_TOKEN\" ]; then\n  echo \"available=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"available=false\" >> \"$GITHUB_OUTPUT\"\nfi\n"
            },
            {
              "name": "Set up MATLAB",
              "if": "steps.matlab.outputs.available == 'true'",
              "uses": "matlab-actions/setup-matlab@v2",
              "with": {
                "release": "R2024b",
                "products": "MATLAB"
              }
            },
            {
              "name": "Load EEGLAB sample data",
              "if": "steps.matlab.outputs.available == 'true'",
              "uses": "matlab-actions/run-command@v2",
              "with": {
                "command": "cd(getenv('GITHUB_WORKSPACE'));\neeglab('nogui');\nEEG = pop_loadset('filename', 'eeglab_data.set', 'filepath', 'sample_data/');\nEEG = eeg_checkset(EEG);\nassert(EEG.nbchan == size(EEG.data, 1));\nassert(EEG.pnts == size(EEG.data, 2));\n"
              }
            },
            {
              "name": "Skip MATLAB smoke",
              "if": "steps.matlab.outputs.available != 'true'",
              "run": "echo \"MATLAB smoke skipped because MATLAB_BATCH_TOKEN is not configured.\"\n"
            }
          ],
          "type": "array",
          "env_var": null,
          "description": ""
        }
      ],
      "parse_errors": []
