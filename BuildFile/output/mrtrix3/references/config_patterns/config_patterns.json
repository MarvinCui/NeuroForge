        },
        {
          "key": "jobs.linux-clang-build.runs-on",
          "value": "ubuntu-latest",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-clang-build.env.SCCACHE_GHA_ENABLED",
          "value": "true",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-clang-build.env.SCCACHE_CACHE_SIZE",
          "value": "2G",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-clang-build.strategy.fail-fast",
          "value": false,
          "type": "boolean",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-clang-build.strategy.matrix.sanitizer",
          "value": [
            "address",
            "thread",
            "undefined"
          ],
          "type": "array",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-clang-build.steps",
          "value": [
            {
              "uses": "actions/checkout@v1",
              "with": {
                "submodules": true,
                "ref": "dev"
              }
            },
            {
              "name": "install dependencies",
              "run": "sudo apt-get update\nsudo apt-get install clang llvm qt6-base-dev libglvnd-dev libeigen3-dev zlib1g-dev libfftw3-dev libpng-dev ninja-build python3-numpy\n"
            },
            {
              "name": "Run sccache-cache",
              "uses": "mozilla-actions/sccache-action@v0.0.9"
            },
            {
              "name": "Get CMake",
              "uses": "lukka/get-cmake@latest",
              "with": {
                "cmakeVersion": "3.22.3"
              }
            },
            {
              "name": "Print CMake version",
              "run": "cmake --version"
            },
            {
              "name": "configure",
              "run": "cmake -B build -G Ninja -D CMAKE_BUILD_TYPE=RelWithDebInfo -D MRTRIX_BUILD_TESTS=ON -D ECM_ENABLE_SANITIZERS=${{ matrix.sanitizer }} -D CMAKE_C_COMPILER=clang -D CMAKE_CXX_COMPILER=clang++\n"
            },
            {
              "name": "build",
              "run": "cmake --build build"
            },
            {
              "name": "binary tests",
              "run": "cd build && ctest -L binary --output-on-failure"
            },
            {
              "name": "unit tests",
              "run": "cd build && ctest -L unittest --output-on-failure"
            }
          ],
          "type": "array",
          "env_var": null,
          "description": ""
        }
      ],
      "parse_errors": []
    },
