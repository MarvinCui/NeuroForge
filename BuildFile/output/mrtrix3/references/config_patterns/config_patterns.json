            },
            {
              "name": "unit tests",
              "shell": "cmd",
              "run": "msys64\\msys2_shell.cmd -c \"./run_tests units || { cat testing_units.log; false; }\""
            },
            {
              "name": "binary tests",
              "shell": "cmd",
              "run": "msys64\\msys2_shell.cmd -c \"./run_tests binaries || { cat testing_binaries.log; false; }\""
