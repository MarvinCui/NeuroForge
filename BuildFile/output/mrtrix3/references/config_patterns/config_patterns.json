          "key": "jobs.linux-release.runs-on",
          "value": "ubuntu-20.04",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.linux-release.steps",
          "value": [
            {
              "uses": "actions/checkout@v3",
              "with": {
                "fetch-depth": 0,
                "ref": "${{ github.event.inputs.branch }}"
              }
            },
            {
              "name": "Set env vars",
              "id": "envs",
              "run": "commit_sha=$(git rev-parse HEAD)\ndate=$(date +%Y_%m_%d)\necho \"commit_sha=$commit_sha\" >> $GITHUB_OUTPUT\necho \"date=$date\" >> $GITHUB_OUTPUT\necho \"output_name=mrtrix3-linux-$commit_sha-$date\" >> $GITHUB_OUTPUT\n"
            },
            {
              "name": "Install Eigen3",
              "run": "git clone https://gitlab.com/libeigen/eigen.git && cd eigen && git checkout 3.4.0\ncmake -B build && cmake --build build\nsudo cmake --install build\n"
            },
            {
              "name": "Install Qt 6",
              "uses": "jurplel/install-qt-action@v3",
              "with": {
                "version": "6.7.0",
                "set-env": true
              }
            },
            {
              "name": "Run build",
              "run": "./packaging/package-linux-tarball.sh .\nmv mrtrix.tar.gz ${{ steps.envs.outputs.output_name }}.tar.gz\n"
            },
            {
              "name": "Upload release artifact",
              "uses": "actions/upload-artifact@v4",
              "with": {
                "name": "${{ steps.envs.outputs.output_name }}",
                "path": "${{ steps.envs.outputs.output_name }}.tar.gz"
              }
            }
          ],
          "type": "array",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.macos-release.runs-on",
          "value": "macos-latest",
          "type": "string",
          "env_var": null,
          "description": ""
        },
        {
          "key": "jobs.macos-release.steps",
          "value": [
            {
              "uses": "actions/checkout@v3",
              "with": {
                "fetch-depth": 0,
                "ref": "${{ github.event.inputs.branch }}"
              }
            },
            {
              "name": "Set env vars",
              "id": "envs",
              "run": "commit_sha=$(git rev-parse HEAD)\ndate=$(date +%Y_%m_%d)\necho \"commit_sha=$commit_sha\" >> $GITHUB_OUTPUT\necho \"date=$date\" >> $GITHUB_OUTPUT\necho \"output_name=mrtrix3-macos-$commit_sha-$date\" >> $GITHUB_OUTPUT\n"
            },
            {
              "name": "Install deps",
              "run": "brew install numpy cmake qt pkg-config libpng ninja"
            },
            {
              "name": "Run build",
              "run": "cd ./packaging/macos\n./build ${{ github.event.inputs.branch }}\nmv ./mrtrix3-macos-${{ github.event.inputs.branch }}.tar.xz ../../${{ steps.envs.outputs.output_name }}.tar.xz\n"
            },
            {
